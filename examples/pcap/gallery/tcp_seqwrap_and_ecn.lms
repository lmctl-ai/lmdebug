mkdir("build/examples/pcap");
mkdir("images");
mkdir("docs/images/pcap");

# 1. Build a TCP flow crossing the 2^32 sequence wrap boundary with RFC 3168 ECN & fast recovery in lmshark
p = _lmcode_ cli="lmdebug pcap" install="github:lmctl-ai/lmdebug@latest";
let cap = shark.capture();

let cip = "10.80.1.10";
let sip = "10.80.2.80";
let isn = 4294966271;
let wrap_mod = 4294967296;

# ECN-capable 3-way handshake near 2^32 - 1025 (ISN = 0xfffffbff)
cap.tcp_segment(0.000, cip, 54100, sip, 443, isn, 0, "SYN,ECE,CWR", 64240, "");
cap.tcp_segment(0.008, sip, 443, cip, 54100, 9000, isn + 1, "SYN,ACK,ECE", 65535, "");
cap.tcp_segment(0.016, cip, 54100, sip, 443, isn + 1, 9001, "ACK", 64240, "");

let chunk = "0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF";
let clen = 128;
let rel = 0;
let t = 0.022;

# Send 20 segments (2560 bytes) crossing 2^32 at rel = 1024 (segment i = 8)
for (i in range(0, 20)) {
    let raw_seq = (isn + 1 + rel) % wrap_mod;
    let raw_next = (isn + 1 + rel + clen) % wrap_mod;
    let win = 64000 - i * 900;
    let tx_flags = "PSH,ACK";
    if (i == 11) {
        # Sender acknowledges ECN congestion echo with CWR and halves congestion window
        tx_flags = "PSH,ACK,CWR";
    }
    if (i >= 11) {
        win = 32000 + (i - 11) * 1400;
    }
    cap.tcp_segment(t, cip, 54100, sip, 443, raw_seq, 9001, tx_flags, win, chunk);

    let rx_flags = "ACK";
    if (i == 10) {
        # Receiver signals ECN Congestion Experienced via ECE flag right after wrap
        rx_flags = "ACK,ECE";
    }
    cap.tcp_segment(t + 0.007, sip, 443, cip, 54100, 9001, raw_next, rx_flags, win, "");

    if (i == 14) {
        # Post-wrap retransmission of segment 14 (raw_seq = (isn + 1 + 14*128) % 2^32 = 768)
        cap.tcp_segment(t + 0.010, cip, 54100, sip, 443, raw_seq, 9001, "PSH,ACK", 30000, chunk);
    }
    rel = rel + clen;
    t = t + 0.014;
}

# Verify ECN flag filtering, wrap-around relative sequence continuity, and stream reassembly
assert_eq(cap.filter("tcp.flags.ece == 1").packet_count(), 3);
assert_eq(cap.filter("tcp.flags.cwr == 1").packet_count(), 2);
assert_eq(cap.retransmission_count(), 1);
assert_eq(cap.tcp_stream_bytes(0, "c2s"), 2560);

cap.save_time_sequence_csv(0, "build/examples/pcap/tcp_seqwrap_ecn.csv");
end _lmcode_
savedsl(p, "build/examples/pcap/tcp_seqwrap_ecn.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/pcap/tcp_seqwrap_ecn.dslb;
assert(r.code == 0);

# 2. Plot Continuous Relative Sequence Across 2^32 Wrap & ECN Window Control in lmplot
plt = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/tcp_seqwrap_and_ecn.png", 900, 560);
plot.cmd("set datafile separator ','");
plot.cmd("set grid lw 1 lc rgb '#d0d7de'");
plot.cmd("set title 'TCP 32-Bit Sequence Wrap-Around (0xFFFFFC00 -> 0x00000600) and RFC 3168 ECN Control (lmshark)' noenhanced font ',12'");
plot.cmd("set xlabel 'Capture Time (s)'");
plot.cmd("set ylabel 'Continuous Relative Sequence / ACK (Bytes)'");
plot.cmd("set y2label 'Advertised Window (Bytes)'");
plot.cmd("set ytics nomirror");
plot.cmd("set y2tics 0, 16000, 68000");
plot.cmd("set yrange [0:3000]");
plot.cmd("set y2range [0:74000]");
plot.cmd("set key bottom right box opaque noenhanced font ',9' samplen 2");
plot.cmd("set arrow 1 from 0.0,1025 to 0.31,1025 nohead lw 1.8 dt 2 lc rgb '#8957e5'");
plot.cmd("set label 1 '32-Bit Wire Sequence Wrap Boundary (raw seq 0xFFFFFFFF -> 0x00000000 at rel = 1025 B)' at 0.010,1120 tc rgb '#8957e5' noenhanced font ',9'");
plot.cmd("set arrow 2 from 0.176,1200 to 0.176,2250 nohead lw 1.6 dt 3 lc rgb '#d29922'");
plot.cmd("set label 2 'ECN ECE Echo + CWR Window Cut (55 KB -> 32 KB)' at 0.095,2340 tc rgb '#d29922' noenhanced font ',9'");
plot.cmd("plot 'build/examples/pcap/tcp_seqwrap_ecn.csv' every ::1 using 1:($3 > $4 ? $3 : $4) axes x1y1 with lines lw 1.6 lc rgb '#58a6ff' notitle, '' every ::1 using (strcol(2) eq 'c2s' ? $1 : 1/0):3 axes x1y1 with points pt 7 ps 1.0 lc rgb '#0969da' title 'Client Sent Relative Seq (c2s across 2^32 wrap)', '' every ::1 using (strcol(2) eq 's2c' ? $1 : 1/0):4 axes x1y1 with points pt 5 ps 1.0 lc rgb '#2ea043' title 'Server Cumulative ACK (s2c)', '' every ::1 using ($7 == 1 ? $1 : 1/0):3 axes x1y1 with points pt 7 ps 2.0 lc rgb '#cf222e' title 'Post-Wrap Fast Retransmission (raw seq = 768)', '' every ::1 using 1:6 axes x1y2 with lines lw 2.4 lc rgb '#d29922' title 'Advertised Window w/ RFC 3168 CWR Reduction (right axis)'");
plot.close();
end _lmcode_
savedsl(plt, "build/examples/pcap/tcp_seqwrap_ecn_plot.dslb");
rp = system ${dsl_cli(plt)} --lmcode build/examples/pcap/tcp_seqwrap_ecn_plot.dslb;
assert(rp.code == 0);
copy_file("images/tcp_seqwrap_and_ecn.png", "docs/images/pcap/tcp_seqwrap_and_ecn.png");
