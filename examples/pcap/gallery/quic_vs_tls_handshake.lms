mkdir("build/examples/pcap");
mkdir("images");
mkdir("docs/images/pcap");

# 1. Compare QUIC v2 (1-RTT) vs TCP+TLS 1.3 (2-RTT) vs TCP+TLS 1.2 (3-RTT) over a 40 ms WAN link in lmshark
p = _lmcode_ cli="lmdebug pcap" install="github:lmctl-ai/lmdebug@latest";

# Capture A: QUIC v2 over UDP :443 (1 RTT = 40 ms to encrypted application payload delivery)
let qcap = shark.capture();
qcap.quic_initial(0.000, "10.60.0.10", 55443, "198.51.100.99", 443, "v2", "0102030405060708", "aabbccdd", 1, 320);
qcap.quic_handshake(0.020, "198.51.100.99", 443, "10.60.0.10", 55443, "v2", "aabbccdd", "0102030405060708", 1, 640);
qcap.quic_handshake(0.040, "10.60.0.10", 55443, "198.51.100.99", 443, "v2", "0102030405060708", "aabbccdd", 2, 180);
for (i in range(0, 12)) {
    let t = 0.045 + float(i) * 0.012;
    qcap.quic_short(t, "198.51.100.99", 443, "10.60.0.10", 55443, "aabbccdd", i + 10, 960);
}
qcap.save_io_graph_csv(0.015, "build/examples/pcap/wan_quic_v2.csv");

# Capture B: TCP + TLS 1.3 (1 RTT TCP + 1 RTT TLS 1.3 = 80 ms before encrypted app stream)
let t13 = shark.capture();
t13.tcp_handshake(0.000, "10.60.0.10", 51443, "198.51.100.99", 443, 0.040);
t13.tls_client_hello(0.042, "10.60.0.10", 51443, "198.51.100.99", 443, 1001, 5001, "wan.lmctl.ai", "1.3", "h2");
t13.tls_server_hello(0.062, "198.51.100.99", 443, "10.60.0.10", 51443, 5001, 1094, "1.3", "h2", 4865);
for (i in range(0, 12)) {
    let t = 0.085 + float(i) * 0.012;
    t13.tls_app_data(t, "198.51.100.99", 443, "10.60.0.10", 51443, 5090 + i * 960, 1094, 920);
}
t13.save_io_graph_csv(0.015, "build/examples/pcap/wan_tls13.csv");

# Capture C: TCP + Legacy TLS 1.2 (1 RTT TCP + 2 RTT TLS 1.2 = 120 ms before app stream)
let t12 = shark.capture();
t12.tcp_handshake(0.000, "10.60.0.10", 52443, "198.51.100.99", 443, 0.040);
t12.tls_client_hello(0.042, "10.60.0.10", 52443, "198.51.100.99", 443, 1001, 5001, "wan.lmctl.ai", "1.2", "http/1.1");
t12.tls_server_hello(0.062, "198.51.100.99", 443, "10.60.0.10", 52443, 5001, 1096, "1.2", "http/1.1", 49199);
# Second TLS 1.2 round-trip (ClientKeyExchange / ChangeCipherSpec / Finished)
t12.tcp_segment(0.082, "10.60.0.10", 52443, "198.51.100.99", 443, 1096, 5092, "PSH,ACK", 64240, "TLS12_CLIENT_KEY_EXCHANGE_CCS_FINISHED");
t12.tcp_segment(0.102, "198.51.100.99", 443, "10.60.0.10", 52443, 5092, 1134, "PSH,ACK", 65535, "TLS12_SERVER_CCS_FINISHED");
for (i in range(0, 12)) {
    let t = 0.125 + float(i) * 0.012;
    t12.tls_app_data(t, "198.51.100.99", 443, "10.60.0.10", 52443, 5117 + i * 960, 1134, 920);
}
t12.save_io_graph_csv(0.015, "build/examples/pcap/wan_tls12.csv");

assert_eq(qcap.pkt_field(0, "quic.version"), "v2");
assert_eq(t13.pkt_field(3, "tls.version"), "TLS 1.3");
assert_eq(t12.pkt_field(3, "tls.version"), "TLS 1.2");
end _lmcode_
savedsl(p, "build/examples/pcap/quic_vs_tls.dslb");
r = system ${dsl_cli(p)} --lmcode build/examples/pcap/quic_vs_tls.dslb;
assert(r.code == 0);

# 2. Plot Cumulative Wire Bytes vs WAN Time (QUIC v2 vs TLS 1.3 vs TLS 1.2) in lmplot
plt = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/quic_vs_tls_handshake.png", 900, 540);
plot.cmd("set datafile separator ','");
plot.cmd("set grid lw 1 lc rgb '#d0d7de'");
plot.cmd("set title 'WAN Handshake Head-Start (40 ms RTT): QUIC v2 (1-RTT) vs TLS 1.3 (2-RTT) vs TLS 1.2 (3-RTT)' font ',12'");
plot.cmd("set xlabel 'Elapsed WAN Time (s)'");
plot.cmd("set ylabel 'Cumulative Delivered Bytes'");
plot.cmd("set xrange [0:0.27]");
plot.cmd("set yrange [0:22000]");
plot.cmd("set key top left box opaque font ',10'");
plot.cmd("set arrow 1 from 0.045,0 to 0.045,14000 nohead lw 1.6 dt 3 lc rgb '#2ea043'");
plot.cmd("set label 1 'QUIC App Data\n(t = 45 ms)' at 0.047,11200 tc rgb '#2ea043' font ',9'");
plot.cmd("set arrow 2 from 0.085,0 to 0.085,14000 nohead lw 1.6 dt 3 lc rgb '#8957e5'");
plot.cmd("set label 2 'TLS 1.3 App Data\n(t = 85 ms)' at 0.087,8200 tc rgb '#8957e5' font ',9'");
plot.cmd("set arrow 3 from 0.125,0 to 0.125,14000 nohead lw 1.6 dt 3 lc rgb '#cf222e'");
plot.cmd("set label 3 'TLS 1.2 App Data\n(t = 125 ms)' at 0.127,5200 tc rgb '#cf222e' font ',9'");
plot.cmd("plot 'build/examples/pcap/wan_quic_v2.csv' every ::1 using 1:3 smooth cumulative with lines lw 3.0 lc rgb '#2ea043' title 'QUIC v2 over UDP :443 (1-RTT Handshake)', 'build/examples/pcap/wan_tls13.csv' every ::1 using 1:3 smooth cumulative with lines lw 2.8 lc rgb '#8957e5' title 'TCP + TLS 1.3 (2-RTT Total Handshake)', 'build/examples/pcap/wan_tls12.csv' every ::1 using 1:3 smooth cumulative with lines lw 2.6 lc rgb '#cf222e' title 'TCP + Legacy TLS 1.2 (3-RTT Total Handshake)'");
plot.close();
end _lmcode_
savedsl(plt, "build/examples/pcap/quic_vs_tls_plot.dslb");
rp = system ${dsl_cli(plt)} --lmcode build/examples/pcap/quic_vs_tls_plot.dslb;
assert(rp.code == 0);
copy_file("images/quic_vs_tls_handshake.png", "docs/images/pcap/quic_vs_tls_handshake.png");
