# Which DNS resolver should this laptop use? 600 lookups rotate between the home router's
# cache, the ISP resolver and a public anycast resolver. lmshark pairs every response with
# its query (dns.time, the same field Wireshark shows) and the CDF answers the question:
# the router wins on cache hits but its misses are the slowest; the ISP is the most
# predictable; unanswered queries (lost UDP) are counted, not hidden.
mkdir("build/examples/pcap");
mkdir("images");
mkdir("docs/images/pcap");

p = _lmcode_ cli="lmdebug pcap" install="github:lmctl-ai/lmdebug@latest";
let c = shark.capture();
let me = "192.168.1.42";
let seed = 4242;
let router_fast = 0;
let lost = 0;
for (i in range(0, 600)) {
    let t = 0.5 + float(i) * 0.040;
    let k = i % 3;
    let res = "192.168.1.1";
    if (k == 1) {
        res = "203.0.113.53";
    }
    if (k == 2) {
        res = "1.1.1.1";
    }
    let name = "svc" + str(i % 47) + ".shop.example.net";
    let txid = 1000 + i;
    let port = 50000 + (i % 2000);
    c.dns_query(t, me, port, res, txid, name, "A");
    seed = (seed * 1103515245 + 12345) % 2147483648;
    let u1 = float(seed) / 2147483648.0;
    seed = (seed * 1103515245 + 12345) % 2147483648;
    let u2 = float(seed) / 2147483648.0;
    let ms = 0.0;
    if (k == 0) {
        ms = 1.2 + 2.0 * u2;
        if (u1 >= 0.85) {
            ms = 22.0 + 30.0 * u2;
        }
    }
    if (k == 1) {
        ms = 9.0 + 6.0 * u2;
        if (u1 < 0.05) {
            ms = ms + 40.0;
        }
    }
    if (k == 2) {
        ms = 14.0 + 25.0 * pow(u2, 4.0);
    }
    # about 1.5 % of datagrams never come back
    if (u1 > 0.4 && u1 < 0.415) {
        lost = lost + 1;
    } else {
        if (k == 0 && ms < 5.0) {
            router_fast = router_fast + 1;
        }
        c.dns_response(t + ms / 1000.0, res, me, port, txid, name, "A", "198.51.100." + str(10 + i % 200), 0);
    }
}
let answered = 600 - lost;
print("answered=" + str(answered) + " lost=" + str(lost) + " router_cache_hits=" + str(router_fast));
assert_eq(c.count("dns.flags.response == 0"), 600);
assert_eq(c.count("dns.time"), answered);
assert_eq(c.count("ip.src == 192.168.1.1 && dns.time < 5"), router_fast);
assert_eq(c.count("dns.time > 60"), 0);
c.save_fields_csv("dns.time && ip.src == 192.168.1.1", "dns.time,dns.qname", "build/examples/pcap/dns_router.csv");
c.save_fields_csv("dns.time && ip.src == 203.0.113.53", "dns.time,dns.qname", "build/examples/pcap/dns_isp.csv");
c.save_fields_csv("dns.time && ip.src == 1.1.1.1", "dns.time,dns.qname", "build/examples/pcap/dns_public.csv");
c.save_pcapng("build/examples/pcap/dns_latency.pcapng");
end _lmcode_
savedsl(p, "build/examples/pcap/dns_latency.dslb");
r = system ${dsl_cli(p)} --dsl build/examples/pcap/dns_latency.dslb;
if (r.code != 0) {
  print(r.stdout + r.stderr);
}
assert(r.code == 0);

plt = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/dns_latency.png", 960, 540);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 1,2 title 'DNS resolver shoot-out: 600 lookups, latency from lmshark dns.time (query/response matching)' font ',13'");
plot.cmd("set grid lw 1 lc rgb '#d0d7de'");
plot.cmd("stats 'build/examples/pcap/dns_router.csv' every ::1 using 1 nooutput name 'R'");
plot.cmd("stats 'build/examples/pcap/dns_isp.csv' every ::1 using 1 nooutput name 'I'");
plot.cmd("stats 'build/examples/pcap/dns_public.csv' every ::1 using 1 nooutput name 'P'");
plot.cmd("set title 'Cumulative distribution (log time axis)' font ',11'");
plot.cmd("set logscale x; set xrange [1:80]; set yrange [0:1.02]");
plot.cmd("set xlabel 'Response time (ms)'; set ylabel 'Fraction of lookups answered'");
plot.cmd("unset key");
plot.cmd("set label 1 'home router' at 1.35, 0.05 left tc rgb '#1a7f37' font ',10'");
plot.cmd("set label 2 'ISP' at 8.4, 0.05 right tc rgb '#0969da' font ',10'");
plot.cmd("set label 3 'public' at 15.5, 0.12 left tc rgb '#8250df' font ',10'");
plot.cmd("plot 'build/examples/pcap/dns_router.csv' every ::1 using 1:(1.0/R_records) smooth cumulative lw 2.5 lc rgb '#1a7f37' title 'home router', 'build/examples/pcap/dns_isp.csv' every ::1 using 1:(1.0/I_records) smooth cumulative lw 2.5 lc rgb '#0969da' title 'ISP', 'build/examples/pcap/dns_public.csv' every ::1 using 1:(1.0/P_records) smooth cumulative lw 2.5 lc rgb '#8250df' title 'public'");
plot.cmd("unset logscale x; unset label 1; unset label 2; unset label 3");
plot.cmd("set title 'Every lookup (jittered strip) with median and worst case' font ',11'");
plot.cmd("set xrange [-0.6:2.6]; set yrange [0:62]");
plot.cmd("set xlabel ''; set ylabel 'Response time (ms)'");
plot.cmd("set xtics ('home router' 0, 'ISP' 1, 'public' 2)");
plot.cmd("unset key");
plot.cmd("set arrow 11 from -0.34, R_median to 0.34, R_median nohead lw 3 lc rgb '#24292f' front");
plot.cmd("set arrow 12 from 0.66, I_median to 1.34, I_median nohead lw 3 lc rgb '#24292f' front");
plot.cmd("set arrow 13 from 1.66, P_median to 2.34, P_median nohead lw 3 lc rgb '#24292f' front");
plot.cmd("set label 11 sprintf('median %.1f, max %.1f', R_median, R_max) at 0.36, R_max center offset 0,1.2 font ',9'");
plot.cmd("set label 12 sprintf('median %.1f, max %.1f', I_median, I_max) at 1.0, I_max center offset 0,1.2 font ',9'");
plot.cmd("set label 13 sprintf('median %.1f, max %.1f', P_median, P_max) at 2.0, P_max center offset 0,1.2 font ',9'");
plot.cmd("plot 'build/examples/pcap/dns_router.csv' every ::1 using (0 + 0.6*(rand(0)-0.5)):1 with points pt 7 ps 0.45 lc rgb '#1a7f37', 'build/examples/pcap/dns_isp.csv' every ::1 using (1 + 0.6*(rand(0)-0.5)):1 with points pt 7 ps 0.45 lc rgb '#0969da', 'build/examples/pcap/dns_public.csv' every ::1 using (2 + 0.6*(rand(0)-0.5)):1 with points pt 7 ps 0.45 lc rgb '#8250df'");
plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(plt, "build/examples/pcap/dns_latency_plot.dslb");
rp = system ${dsl_cli(plt)} --dsl build/examples/pcap/dns_latency_plot.dslb;
assert(rp.code == 0);
copy_file("images/dns_latency.png", "docs/images/pcap/dns_latency.png");
print("wrote images/dns_latency.png");
