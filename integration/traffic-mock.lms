# SPDX-License-Identifier: MIT
program = _lmcode_ schema="lmmock-schema.json";
@health
fn health(x: Exchange) -> void implements Handler {
  x.set_header("Content-Type", "application/json");
  x.json("{\"sentinel\":\"LMDEBUG_LOOPBACK_HEALTH_V1\"}");
}
@echo
fn echo(x: Exchange) -> void implements Handler { x.set_header("Content-Type", "text/plain"); x.send(x.body()); }
route("GET", "/health", "health");
route("POST", "/echo", "echo");
end _lmcode_
savedsl(program, ARGV[0]);
